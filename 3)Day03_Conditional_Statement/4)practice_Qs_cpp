//Create an income Tax calculator

#include<iostream>
using namespace std;

int main(){
	int income;
	float tax;
	
	cout<<"Enter income(in lakhs):";
	cin>>income;
	
	if(income<5){
		tax=0;
	}
	else if(income<=10){
		tax=0.2*income;
	}
	else{
		tax=0.3*income;
	}
		cout<<"Tax is:"<<(tax *100000)<<endl;
	return 0;
}
// output:
// Enter income(in lakhs):10
// Tax is:200000